# Copy to .env and fill in. Never commit .env.

# PostgreSQL connection for the app's own database user (not the postgres superuser).
DATABASE_URL="postgresql://saac:change-me@localhost:5432/saac"

# Port the single Node process listens on (API + built web app).
PORT=3000

# Sign a session out after this many minutes without activity.
SESSION_IDLE_MINUTES=15

# Set to true when the app is served over HTTPS, so the session cookie is only sent over HTTPS.
COOKIE_SECURE=false

# The dashboard turns system health red when the last successful backup is older than this.
BACKUP_STALE_HOURS=30

# Where scripts/backup.mjs writes dump files. Use the full network path on Windows, never a mapped drive letter.
BACKUP_DIR="./backups"

# Optional: full path to pg_dump if it is not on PATH (Windows: C:\Program Files\PostgreSQL\16\bin\pg_dump.exe).
PG_DUMP_PATH=""

# Look book titles up on Open Library by ISBN when adding them. The only call the app makes outside
# the host. Set to false to always type titles by hand.
OPEN_LIBRARY_LOOKUP=true
