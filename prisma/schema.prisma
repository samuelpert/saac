generator client {
  provider = "prisma-client"
  output   = "../apps/api/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  STAFF
}

enum ItemStatus {
  IN_SERVICE
  IN_REPAIR
  SURPLUS
}

enum BorrowerKind {
  ATHLETE
  STAFF
  GRAD_ASSISTANT
}

enum EscalationStage {
  NONE
  REMINDED
  COACH_NOTIFIED
  HOLD_PENDING_REVIEW
  ON_HOLD
  CHARGED
  RESOLVED
}

enum LoanOutcome {
  RETURNED
  NOT_FOR_RETURN
}

enum EmailStatus {
  PREVIEWED
  SENT
  FAILED
}

enum NeedStatus {
  NEEDED
  ASSIGNED
  ISSUED
  WAIVED
  CANCELLED
}

enum NeedSource {
  SCHEDULE
  BOOKSTORE_LIST
  MANUAL
}

model User {
  id                 String   @id @default(uuid())
  username           String   @unique
  email              String?
  name               String
  passwordHash       String
  mustChangePassword Boolean  @default(true)
  role               Role     @default(STAFF)
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())

  auditLogs  AuditLog[]
  importRuns ImportRun[]
  sessions   Session[]
}

// One row per signed-in browser. The cookie holds a random token; only its SHA-256 is stored.
model Session {
  id         String   @id @default(uuid())
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime

  @@index([userId])
}

model Team {
  id         String  @id @default(uuid())
  name       String  @unique
  coachName  String?
  coachEmail String?

  borrowers Borrower[]
  mappings  GroupMapping[]
}

model GroupMapping {
  id          String       @id @default(uuid())
  sourceValue String       @unique
  kind        BorrowerKind
  teamId      String?
  team        Team?        @relation(fields: [teamId], references: [id])
}

model Borrower {
  id            String       @id @default(uuid())
  pid           String       @unique
  kind          BorrowerKind @default(ATHLETE)
  firstName     String
  lastName      String
  email         String?
  phone         String?
  onScholarship Boolean      @default(false)
  /// Staff only: an active staff member can borrow tech. Ignored for students (athletes and graduate assistants).
  staffActive   Boolean      @default(true)
  teamId        String?
  team          Team?        @relation(fields: [teamId], references: [id])
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  terms       BorrowerTerm[]
  enrollments Enrollment[]
  bookLoans   BookLoan[]
  itemLoans   ItemLoan[]
  escalations Escalation[]
  emails      EmailLog[]
  needs       BookNeed[]

  @@index([lastName, firstName])
}

model Semester {
  id             String   @id @default(uuid())
  code           String   @unique
  startsOn       DateTime
  endsOn         DateTime
  returnDeadline DateTime
  isCurrent      Boolean  @default(false)

  members     BorrowerTerm[]
  courses     Course[]
  bookLoans   BookLoan[]
  itemLoans   ItemLoan[]
  escalations Escalation[]
  needs       BookNeed[]
}

// The term tag. A person is in a term when this row exists; they keep every tag they have earned.
// A person can borrow in a term when they carry its tag and, for athletes, are on scholarship.
model BorrowerTerm {
  borrowerId String
  semesterId String
  borrower   Borrower @relation(fields: [borrowerId], references: [id])
  semester   Semester @relation(fields: [semesterId], references: [id])
  createdAt  DateTime @default(now())

  @@id([borrowerId, semesterId])
  @@index([semesterId])
}

model Course {
  id         String   @id @default(uuid())
  semesterId String
  semester   Semester @relation(fields: [semesterId], references: [id])
  subject    String
  catalog    String
  section    String

  enrollments Enrollment[]
  books       CourseBook[]
  needs       BookNeed[]

  @@unique([semesterId, subject, catalog, section])
}

model Enrollment {
  borrowerId String
  courseId   String
  borrower   Borrower @relation(fields: [borrowerId], references: [id])
  course     Course   @relation(fields: [courseId], references: [id])

  @@id([borrowerId, courseId])
}

model Book {
  id            String   @id @default(uuid())
  isbn          String   @unique
  title         String
  author        String?
  edition       String?
  publisher     String?
  publishedYear String?
  notes         String?
  updatedAt     DateTime @updatedAt

  courses CourseBook[]
  copies  BookCopy[]
  needs   BookNeed[]
}

model CourseBook {
  courseId String
  bookId   String
  course   Course @relation(fields: [courseId], references: [id])
  book     Book   @relation(fields: [bookId], references: [id])

  @@id([courseId, bookId])
}

model BookNeed {
  id         String     @id @default(uuid())
  borrowerId String
  semesterId String
  bookId     String
  borrower   Borrower   @relation(fields: [borrowerId], references: [id])
  semester   Semester   @relation(fields: [semesterId], references: [id])
  book       Book       @relation(fields: [bookId], references: [id])
  courseId   String?
  course     Course?    @relation(fields: [courseId], references: [id])
  status     NeedStatus @default(NEEDED)
  copyId     String?
  copy       BookCopy?  @relation(fields: [copyId], references: [id])
  source     NeedSource
  note       String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  loans BookLoan[]

  @@unique([borrowerId, semesterId, bookId])
  @@index([semesterId, status])
}

model BookCopy {
  id         String    @id @default(uuid())
  copyTag    String    @unique
  bookId     String
  book       Book      @relation(fields: [bookId], references: [id])
  condition  String?
  notes      String?
  acquiredAt DateTime  @default(now())
  retiredAt  DateTime?

  loans BookLoan[]
  needs BookNeed[]
}

model ItemType {
  id    String @id @default(uuid())
  name  String @unique
  items Item[]
}

model Item {
  id         String    @id @default(uuid())
  assetTag   String    @unique
  name       String
  typeId     String
  type       ItemType  @relation(fields: [typeId], references: [id])
  notes      String?
  status     ItemStatus @default(IN_SERVICE)
  statusNote String?
  retiredAt  DateTime?

  loans ItemLoan[]
}

model BookLoan {
  id           String       @id @default(uuid())
  borrowerId   String
  copyId       String
  semesterId   String
  borrower     Borrower     @relation(fields: [borrowerId], references: [id])
  copy         BookCopy     @relation(fields: [copyId], references: [id])
  needId       String?
  need         BookNeed?    @relation(fields: [needId], references: [id])
  semester     Semester     @relation(fields: [semesterId], references: [id])
  checkedOutAt DateTime     @default(now())
  dueDate      DateTime
  closedAt     DateTime?
  outcome      LoanOutcome?
  outcomeNote  String?
  conditionIn  String?
  notes        String?

  @@index([borrowerId, semesterId])
  @@index([copyId, closedAt])
}

model ItemLoan {
  id           String       @id @default(uuid())
  borrowerId   String
  itemId       String
  semesterId   String
  borrower     Borrower     @relation(fields: [borrowerId], references: [id])
  item         Item         @relation(fields: [itemId], references: [id])
  semester     Semester     @relation(fields: [semesterId], references: [id])
  checkedOutAt DateTime     @default(now())
  dueDate      DateTime
  closedAt     DateTime?
  outcome      LoanOutcome?
  outcomeNote  String?
  renewCount   Int          @default(0)
  conditionOut String?
  conditionIn  String?
  notes        String?

  @@index([borrowerId, semesterId])
  @@index([itemId, closedAt])
}

model Escalation {
  id           String          @id @default(uuid())
  borrowerId   String
  semesterId   String
  borrower     Borrower        @relation(fields: [borrowerId], references: [id])
  semester     Semester        @relation(fields: [semesterId], references: [id])
  stage        EscalationStage @default(NONE)
  chargeAmount Decimal?        @db.Decimal(10, 2)
  note         String?
  updatedAt    DateTime        @updatedAt

  @@unique([borrowerId, semesterId])
}

model EmailLog {
  id         String      @id @default(uuid())
  borrowerId String
  borrower   Borrower    @relation(fields: [borrowerId], references: [id])
  kind       String
  status     EmailStatus
  subject    String
  body       String
  sentAt     DateTime?
  createdAt  DateTime    @default(now())
}

model ImportRun {
  id         String    @id @default(uuid())
  kind       String
  fileName   String
  fileSha256 String
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  counts     Json
  createdAt  DateTime  @default(now())
  appliedAt  DateTime?
}

model BackupRun {
  id        String   @id @default(uuid())
  at        DateTime @default(now())
  ok        Boolean
  location  String
  sizeBytes BigInt?
  message   String?
}

model AuditLog {
  id         String   @id @default(uuid())
  at         DateTime @default(now())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?

  @@index([entityType, entityId])
  @@index([at])
}

// Open Library answers, kept so a title looked up once fills in again with no network.
model IsbnLookup {
  isbn      String   @id
  found     Boolean
  data      Json?
  fetchedAt DateTime @default(now())
}
